            function prevAbout() {
                const prev = (aboutIndex - 1 + aboutSlides.length) % aboutSlides.length;
                showAboutSlide(prev);
            }

            // 좌우 버튼
            if (prevBtn && nextBtn) {
                nextBtn.addEventListener('click', nextAbout);
                prevBtn.addEventListener('click', prevAbout);
