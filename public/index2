    // 캘린더 렌더링
    function renderScheduleCalendar() {
        const grid = document.getElementById('scheduleCalendarGrid');
        const monthTitle = document.getElementById('scheduleMonthTitle');
        
        monthTitle.textContent = `${scheduleCurrentYear}년 ${scheduleCurrentMonth}월 `;
        
        const existingDays = grid.querySelectorAll('.schedule-calendar-day');
        existingDays.forEach(day => day.remove());
        
        const firstDay = new Date(scheduleCurrentYear, scheduleCurrentMonth - 1, 1);
        const lastDay = new Date(scheduleCurrentYear, scheduleCurrentMonth, 0);
        const daysInMonth = lastDay.getDate();
        const startDayOfWeek = firstDay.getDay();
        
        for (let i = 0; i < startDayOfWeek; i++) {
            const emptyCell = document.createElement('div');
            emptyCell.className = 'schedule-calendar-day';
            emptyCell.style.visibility = 'hidden';
            grid.appendChild(emptyCell);
        }
        
        const today = new Date();
        for (let day = 1; day <= daysInMonth; day++) {
            const dayCell = document.createElement('div');
            dayCell.className = 'schedule-calendar-day';
            dayCell.textContent = day;
            dayCell.onclick = () => selectScheduleDate(day, dayCell);
            
            if (scheduleCurrentYear === today.getFullYear() && 
                scheduleCurrentMonth === today.getMonth() + 1 && 
                day === today.getDate()) {
                dayCell.classList.add('today');
            }
            
            if (scheduleData[day] && scheduleData[day].length > 0) {
                dayCell.classList.add('has-event');
            }
            
            grid.appendChild(dayCell);
        }
    }

    // 날짜 선택
    async function selectScheduleDate(day, element) {
        document.querySelectorAll('.schedule-calendar-day').forEach(d => d.classList.remove('selected'));
        element.classList.add('selected');
        
        document.getElementById('scheduleEmptyState').classList.remove('show');
        document.getElementById('scheduleNoEvents').classList.remove('show');
        document.getElementById('scheduleEventsSection').classList.remove('show');
        
        const daySchedules = scheduleData[day];
        
        if (!daySchedules || daySchedules.length === 0) {
            document.getElementById('scheduleNoEvents').classList.add('show');
            return;
        }
        
        renderScheduleEvents(day, daySchedules);
    }

    // 일정 렌더링
    function renderScheduleEvents(day, events) {
        const container = document.getElementById('scheduleEventsSection');
        container.innerHTML = '';
        
        events.forEach(event => {
            const card = createScheduleEventCard(day, event);
            container.appendChild(card);
        });
        
        container.classList.add('show');
        setTimeout(() => {
            container.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }, 100);
    }

    // 일정 카드 생성
    function createScheduleEventCard(day, event) {
        const card = document.createElement('div');
        card.className = 'schedule-event-card';
        
        const startTime = new Date(event.startTime);
        const endTime = new Date(event.endTime);
        const timeStr = `${formatScheduleTime(startTime)} - ${formatScheduleTime(endTime)}`;
        
        card.innerHTML = `
            <div class="schedule-event-date-badge">
                📌 ${scheduleCurrentMonth}월 ${day}일
            </div>
            <h3 class="schedule-event-title">${event.title}</h3>
            <div class="schedule-event-details">
                <div class="schedule-event-detail-item">
                    <span class="icon">🕐</span>
                    <span>${timeStr}</span>
                </div>
                ${event.location ? `
                <div class="schedule-event-detail-item">
                <span class="icon">📍</span>
                <span class="schedule-location-link"
                    onclick="openMapModal('${event.location.replace(/'/g, "\\'")}')">
                  ${event.location}
                  <i class="fas fa-map-marked-alt"></i>
                </span>
            </div>
        ` : ''}
        </div>
        ${event.description ? `
        <div class="schedule-event-description">${event.description}</div>
        ` : ''}
    `;
        
        return card;
    }

    // 시간 포맷팅
    function formatScheduleTime(date) {
        const hours = date.getHours();
        const minutes = date.getMinutes();
        const period = hours < 12 ? '오전' : '오후';
        const displayHours = hours % 12 || 12;
        return `${period} ${displayHours}:${minutes.toString().padStart(2, '0')}`;
    }

    // 월 변경
    async function scheduleChangeMonth(delta) {
        scheduleCurrentMonth += delta;
        
        if (scheduleCurrentMonth > 12) {
            scheduleCurrentMonth = 1;
            scheduleCurrentYear++;
        } else if (scheduleCurrentMonth < 1) {
            scheduleCurrentMonth = 12;
            scheduleCurrentYear--;
        }
        
        document.getElementById('scheduleEmptyState').classList.add('show');
        document.getElementById('scheduleEventsSection').classList.remove('show');
        document.getElementById('scheduleNoEvents').classList.remove('show');
        
        await loadScheduleMonthly();
    }

    // 로딩 표시
    function showScheduleLoading(show) {
        document.getElementById('scheduleLoading').classList.toggle('show', show);
        document.getElementById('scheduleCalendarSection').style.display = show ? 'none' : 'block';
    }
