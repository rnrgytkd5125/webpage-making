        // 블로그 슬라이더
        function initBlogSlider() {
            const track = document.querySelector(".blog-slider-track");
            if (!track) return;

            let cards = Array.from(track.querySelectorAll(".blog-slide-card"));
            if (cards.length === 0) return;

            if (cards.length === 1) {
                const dotsBox = document.getElementById("blog-dots");
                if (dotsBox) dotsBox.innerHTML = "";
                return;
            }

            const realCount = cards.length;
            let current = 0;
            let autoTimer = null;

            function getSlideWidth() {
                const firstCard = cards[0];
                return firstCard.offsetWidth + 24;
            }

            function setPosition(noAnim = false) {
                const slideWidth = getSlideWidth();
                const viewportWidth = track.parentElement.offsetWidth;
                const cardWidth = cards[0].offsetWidth;
                
                const initialOffset = (viewportWidth / 2) - (cardWidth / 2);
                const translateX = initialOffset - (current * slideWidth);
                
                if (noAnim) {
                    track.style.transition = "none";
                } else {
                    track.style.transition = "transform 0.6s ease";
                }
                // 현재 카드가 중앙에 오도록 계산 (양쪽 여백 고려)
                const offset = (window.innerWidth * 0.105);  // 슬라이딩 여백 조정***
                track.style.transform = `translateX(calc(-${current * slideWidth}px + ${offset}px))`;
            }
            
            setPosition(true);

            const dotsBox = document.getElementById("blog-dots");
            if (!dotsBox) return;
            dotsBox.innerHTML = "";

            for (let i = 0; i < realCount; i++) {
                const dot = document.createElement("button");
                dot.className = "blog-slider-dot" + (i === 0 ? " active" : "");
                dot.addEventListener("click", () => {
                    current = i;
                    setPosition();
                    updateDots();
                    restartAuto();
                });
                dotsBox.appendChild(dot);
            }
            const dots = dotsBox.querySelectorAll(".blog-slider-dot");

            function updateDots() {
                dots.forEach((dot, i) => {
                    dot.classList.toggle("active", i === current);
                });
            }

            function goNext() {
                current = (current + 1) % realCount;  // 0,1,2,0,1,2...
                setPosition();
                updateDots();
            }

            function startAuto() {
                autoTimer = setInterval(goNext, 5000);
            }
            function restartAuto() {
                if (autoTimer) clearInterval(autoTimer);
                startAuto();
            }

            window.addEventListener("resize", () => {
                setPosition(true);
            });

            startAuto();
        }
    </script>

