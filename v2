<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>국민의 버미 | 신성범 국회의원</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Black+Han+Sans&family=Noto+Sans+KR:wght@300;400;500;700;900&family=Gaegu:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Nanum+Myeongjo:wght@400;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-red: #e46e6c;
            --primary-red-dark: #ee3a3a;
            --accent-orange: #df3f23;
            --navy: #a33434;
            --navy-light: #db2911;
            --sky-blue: #815823;
            --warm-cream: #FFF8E1;
            --warm-yellow: #FFE082;
            --text-dark: #212121;
            --text-light: #FAFAFA;
            --shadow-color: rgba(26, 35, 126, 0.3);
        }
        @font-face {
            font-family: 'BMHannaPro';
            src: url("./fonts/BMHannaPro.ttf") format("truetype");
            font-weight: normal;
            font-style: normal;
        }

        @font-face {
            font-family: 'BMJUA';
            src: url("./fonts/BMJUA_ttf.ttf") format("truetype");
            font-weight: normal;
            font-style: normal;
        }
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Noto Sans KR', sans-serif;
            background: var(--warm-cream);
            color: var(--text-dark);
            overflow-x: hidden;
        }

        /* 손글씨 스타일 타이틀 */
        .hand-drawn {
            font-family: 'Gaegu', cursive;
        }

        .bold-title {
            font-family: 'Black Han Sans', sans-serif;
        }

        /* 네비게이션 */
        nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            background: linear-gradient(135deg, var(--navy) 0%, var(--navy-light) 100%);
            padding: 0.8rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 20px var(--shadow-color);
        }

        .nav-logo {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .nav-logo img {
            height: 50px;
            filter: drop-shadow(2px 2px 4px rgba(112, 90, 90, 0.3));
            transition: transform 0.3s ease;
        }

        .nav-logo img:hover {
            transform: scale(1.1) rotate(-5deg);
        }

        .nav-logo-text {
            font-family: 'Black Han Sans', sans-serif;
            font-size: 1.5rem;
            color: var(--text-light);
            text-shadow: 2px 2px 0 var(--primary-red);
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            list-style: none;
        }

        .nav-links a {
            color: var(--text-light);
            text-decoration: none;
            font-weight: 500;
            font-size: 1rem;
            padding: 0.5rem 1rem;
            border-radius: 25px;
            transition: all 0.3s ease;
            position: relative;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 50%;
            width: 0;
            height: 3px;
            background: var(--warm-yellow);
            transition: all 0.3s ease;
            transform: translateX(-50%);
            border-radius: 2px;
        }

        .nav-links a:hover::after {
            width: 80%;
        }

        .nav-links a:hover {
            color: var(--warm-yellow);
        }

        .nav-auth {
            display: flex;
            gap: 1rem;
        }

        .btn {
            padding: 0.6rem 1.5rem;
            border-radius: 25px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            border: none;
            font-size: 0.95rem;
        }

        .btn-login {
            background: transparent;
            border: 2px solid var(--warm-yellow);
            color: var(--warm-yellow);
        }

        .btn-login:hover {
            background: var(--warm-yellow);
            color: var(--navy);
        }

        .btn-signup {
            background: linear-gradient(135deg, var(--primary-red) 0%, var(--accent-orange) 100%);
            color: white;
            box-shadow: 0 4px 15px rgba(229, 57, 53, 0.4);
        }

        .btn-signup:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(229, 57, 53, 0.5);
        }

        /* 히어로 섹션 */
        .hero {
            min-height: 30vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 6rem 2rem 2rem;
            position: relative;
            overflow: hidden;
        }

        .hero-bg-grid {
            position: absolute;
            inset: 0;
            display: flex;
            flex-wrap: nowrap;      /* 줄바꿈 없이 가로 한 줄 */
            justify-content: center;/* 가운데 정렬 */
            align-items: center;
            opacity: 0.25;          /* 사진을 은은하게 보이게 */
            filter: grayscale(0.2);
            z-index: 0;
            overflow: hidden;       /* 바깥으로 나가는 부분은 잘라냄 */
        }

        .hero-bg-grid img {
            height: 100%;    /* 히어로 높이에 맞춤 */
            width: 40%;     /* 비율 유지 */
            flex: 0 0 auto;  /* 줄어들지 않게 고정 */
        }
        
        /* 듀오톤 오버레이 (빨강 + 오렌지) */
        .hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(
                135deg,
                rgba(221, 130, 128, 0.85) 0%,    /* 빨강 */
                rgba(247, 41, 5, 0.9) 50%,       /* 오렌지 */
                rgba(243, 131, 129, 0.85) 100%   /* 빨강 */
            );
            z-index: 0;
        }

        /* 배경 패턴 (기존 느낌 유지) */
        .hero::after {
            content: '';
            position: absolute;
            inset: 0;
            background-image:
                radial-gradient(circle at 20% 80%, rgba(255,224,130,0.15) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(255,255,255,0.1) 0%, transparent 50%);
            z-index: 0;
            pointer-events: none;
        }

        /* 히어로 안의 전체 콘텐츠 정렬 */
        .hero-content {
            position: relative;
            z-index: 1;

            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;

            max-width: 1400px;
            width: 100%;
        }

        /* 텍스트 블록 애니메이션 */
        .hero-text {
            animation: slideInLeft 1s ease-out;
        }

        @keyframes slideInLeft {
            from { opacity: 0; transform: translateX(-50px); }
            to   { opacity: 1; transform: translateX(0); }
        }

        /* 상단 배지 */
        .hero-badge {
            display: inline-block;
            background: var(--primary-red);
            color: #fff;
            padding: 0.5rem 1.5rem;
            border-radius: 25px;
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 1.2rem;
            box-shadow: 3px 3px 0 var(--accent-orange);
            animation: bounce 2s infinite;
        }

        @keyframes bounce {
            0%,100% { transform: translateY(0); }
            50%     { transform: translateY(-5px); }
        }

        /* 메인 타이틀: 1번 이미지(버미) 스타일 적용 */
        /* 가운데 큰 글자 스타일 */
        .hero-main-title {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.2rem;
            margin-bottom: 1rem;
        }

        .hero-pretitle {
            font-family: 'BMJUA', sans-serif;
            font-size: 1.2rem;
            font-weight: 500;
            letter-spacing: 2px;

            color: rgba(255, 255, 255, 0.95);
            text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.25);

            margin-bottom: 0.5rem;
            margin-top: 0.5rem;
        }

        /* 1줄: "지역의 희망" */
        .title-small {
            font-family: 'BMJUA', cursive;
            font-size: 1.6rem;
            color: #ffffff;
            text-shadow: 2px 2px 0 rgba(0,0,0,0.3);
        }

        /* 2줄: "버 미" – 1번 이미지 느낌 */
        .title-accent {
            display: inline-block;
            font-family: 'Black Han Sans', 'BMJUA', sans-serif;
            font-size: clamp(4rem, 7vw, 8rem);
            line-height: 1;
            padding: 0 0.15em;
            color: #ffffff;
            text-shadow:
                6px 6px 0 #f70505,          /* 빨간 실루엣 */
                10px 10px 0 rgba(0,0,0,0.35); /* 어두운 그림자 */
        }

        .title-accent {
            animation: popUp 0.8s cubic-bezier(0.25, 1.3, 0.5, 1) forwards;
        }

        .title-accent:nth-child(1) { animation-delay: 0.1s; }
        .title-accent:nth-child(2) { animation-delay: 0.25s; }

        @keyframes popUp {
            0%   { transform: translateY(50px) scale(0.8); opacity: 0; }
            70%  { transform: translateY(-6px) scale(1.08); opacity: 1; }
            100% { transform: translateY(0) scale(1); }
        }

        /* 3줄: "와 함께" */
        .title-for {
            font-family: 'BMJUA', cursive;
            font-size: 1.8rem;
            color: var(--warm-yellow);
            text-shadow: 2px 2px 0 rgba(0,0,0,0.3);
        }

        .hero-cta {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 1.2rem;
            margin-top: 1.5rem;
            flex-wrap: wrap;
        }

        /* 기본 버튼 스타일 */
        .btn-hero {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;

            padding: 0.9rem 2rem;
            border-radius: 30px;

            font-size: 1.1rem;
            font-weight: 700;
            text-decoration: none;

            transition: all 0.25s ease;
        }

        /* PRIMARY — 빨강/오렌지 그라데이션 버튼 */
        .btn-primary-hero {
            background: linear-gradient(135deg, var(--warm-yellow), var(--accent-orange));
            color: #fff;

            box-shadow: 0 6px 18px rgba(229, 57, 53, 0.35);
        }

        .btn-primary-hero:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 28px rgba(229, 57, 53, 0.45);
        }

        /* SECONDARY — 테두리 버튼 */
        .btn-secondary-hero {
            background: transparent;
            border: 3px solid var(--warm-yellow);
            color: var(--warm-yellow);

            box-shadow: 0 4px 12px rgba(255, 255, 255, 0.15);
        }

        .btn-secondary-hero:hover {
            background: var(--warm-yellow);
            color: var(--navy);
            transform: translateY(-3px);
        }

        .hero-image {
            display: flex;
            justify-content: center;
            align-items: center;
            animation: slideInRight 1s ease-out;
        }

        @keyframes slideInRight {
            from {
                opacity: 0;
                transform: translateX(50px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .hero-character {
            position: relative;
        }

        .hero-character img {
            max-height: 550px;
            filter: drop-shadow(10px 10px 30px rgba(0,0,0,0.3));
            animation: float 3s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(2deg); }
        }


        /* 섹션 공통 스타일 */
        section {
            padding: 5rem 2rem;
        }

        .section-header {
            text-align: center;
            margin-bottom: 4rem;
        }

        .section-badge {
            display: inline-block;
            background: var(--primary-red);
            color: white;
            padding: 0.4rem 1.2rem;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }
        
        /* #about 섹션 */
        .about {
            background: rgba(243, 227, 208, 0.973);
            padding: 5rem 2rem;
        }

        .about-card {
            max-width: 1100px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 30px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0,0,0,0.12);
        }

        /* 위쪽 사진 슬라이더 영역 (1번 예시처럼 옆으로 넘기는 구조) */
        .about-slider {
            position: relative;
            overflow: hidden;
            height: 380px;            /* 필요하면 높이 조절 */
            background: #000;
        }

        .about-slide {
            position: absolute;
            inset: 0;
            opacity: 0;
            transition: opacity 0.5s ease;
        }

        .about-slide.active {
            opacity: 1;
        }

        .about-slide img {
            width: 100%;
            height: 100%;
            object-fit: cover;        /* 사진이 꽉 차게 */
        }

        /* 좌우 화살표 */
        .about-arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: none;
            background: rgba(0,0,0,0.4);
            color: #fff;
            font-size: 1.5rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s ease;
            z-index: 5;
        }

        .about-arrow:hover {
            background: rgba(0,0,0,0.7);
        }

        .about-prev { left: 20px; }
        .about-next { right: 20px; }

        /* 하단 점 네비게이션 */
        .about-dots {
            position: absolute;
            bottom: 16px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 8px;
            z-index: 6;
        }

        .about-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            border: none;
            background: rgba(255,255,255,0.5);
            cursor: pointer;
            transition: transform 0.2s ease, background 0.2s ease;
        }

        .about-dot.active {
            background: #ffffff;
            transform: scale(1.2);
        }

        /* 아래쪽 컬러 배너 (3번 이미지 느낌) */
        .about-banner {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
            padding: 2rem 2.5rem;
            background: linear-gradient(135deg, var(--primary-red) 0%, var(--accent-orange) 100%);
            color: #ffffff;
        }

        .about-banner-text {
            max-width: 650px;
        }

        .about-banner-label {
            font-size: 0.9rem;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            opacity: 0.9;
            margin-bottom: 0.4rem;
        }

        .about-banner-title {
            font-family: 'BMJUA', sans-serif;
            font-size: 2.2rem;
            margin-bottom: 0.6rem;
        }

        .about-banner-desc {
            font-size: 1rem;
            line-height: 1.7;
            opacity: 0.95;
        }

        /* 버튼 */
        .about-banner-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0.9rem 2.4rem;
            border-radius: 999px;
            background: #ffffff;
            color: var(--primary-red);
            font-weight: 700;
            text-decoration: none;
            white-space: nowrap;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, color 0.2s ease;
        }

        .about-banner-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 14px 35px rgba(0,0,0,0.25);
            background: var(--warm-yellow);
            color: #3c1a1a;
        }

        /* 반응형 */
        @media (max-width: 768px) {
            .about-slider {
                height: 260px;
            }

            .about-banner {
                flex-direction: column;
                align-items: flex-start;
            }

            .about-banner-title {
                font-size: 1.7rem;
            }

            .about-banner-btn {
                width: 100%;
                justify-content: center;
            }
        }

        /* 의정활동 섹션 */
        .activities {
            background: linear-gradient(135deg, var(--navy) 0%, var(--navy-light) 50%, var(--sky-blue) 100%);
            color: rgb(231, 46, 46);
        }

        .activities .section-title {
            color: rgb(8, 0, 0);
        }

        .activities .section-subtitle {
            color: #0a0202e0;
        }

        .activities-grid {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
        }

        .activity-card {
            background: rgba(250, 250, 250, 0.87);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 2rem;
            border: 2px solid rgba(153, 48, 48, 0.2);
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .activity-card:hover {
            transform: translateY(-10px);
            background: rgba(226, 214, 214, 0.15);
            border-color: #000;
        }

        .activity-icon {
            width: 60px;
            height: 60px;
            background: #f0e7e7e0;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 5px 15px rgba(229,57,53,0.4);
        }

        .activity-card h3 {
            font-family: 'BMJUA', sans-serif;
            font-size: 1.4rem;
            margin-bottom: 1rem;
        }

        .activity-card p {
            color: rgba(10, 0, 0, 0.8);
            line-height: 1.6;
            margin-bottom: 1.5rem;
        }

        .activity-date {
            font-size: 0.85rem;
            color: var(--warm-yellow);
            font-weight: 500;
        }

        /* 일정 섹션 */
        .schedule {
            background: var(--warm-cream);
        }

        .schedule-container {
            max-width: 1000px;
            margin: 0 auto;
        }

        .schedule-timeline {
            position: relative;
            padding-left: 50px;
        }

        .schedule-timeline::before {
            content: '';
            position: absolute;
            left: 20px;
            top: 0;
            bottom: 0;
            width: 4px;
            background: linear-gradient(180deg, var(--primary-red), var(--accent-orange), var(--warm-yellow));
            border-radius: 2px;
        }

        .schedule-item {
            position: relative;
            background: white;
            padding: 1.5rem 2rem;
            border-radius: 15px;
            margin-bottom: 1.5rem;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            transition: all 0.3s ease;
        }

        .schedule-item::before {
            content: '';
            position: absolute;
            left: -38px;
            top: 50%;
            transform: translateY(-50%);
            width: 16px;
            height: 16px;
            background: var(--primary-red);
            border-radius: 50%;
            border: 4px solid white;
            box-shadow: 0 0 0 4px var(--primary-red);
        }

        .schedule-item:hover {
            transform: translateX(10px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.12);
        }

        .schedule-date {
            font-weight: 700;
            color: var(--primary-red);
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
        }

        .schedule-title {
            font-family: 'Black Han Sans', sans-serif;
            font-size: 1.3rem;
            color: var(--navy);
            margin-bottom: 0.5rem;
        }

        .schedule-location {
            color: #666;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        /* 버미의 군민들 (지지자 모집) */
        .supporters {
            background: linear-gradient(135deg, var(--primary-red) 0%, var(--accent-orange) 100%);
            color: white;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .supporters::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3z' fill='%23ffffff' fill-opacity='0.05' fill-rule='evenodd'/%3E%3C/svg%3E");
            animation: moveBackground 20s linear infinite;
        }

        @keyframes moveBackground {
            0% { transform: translateX(0) translateY(0); }
            100% { transform: translateX(50px) translateY(50px); }
        }

        .supporters .section-title {
            color: white;
        }

        .supporters .section-subtitle {
            color: var(--warm-yellow);
        }

        .supporters-content {
            max-width: 800px;
            margin: 0 auto;
            position: relative;
            z-index: 1;
        }

        .supporters-description {
            font-size: 1.3rem;
            margin-bottom: 3rem;
            line-height: 1.8;
        }

        .supporters-stats {
